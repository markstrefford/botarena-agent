# BotArena Reference Agent — Configuration
# Copy to .env and fill in your values.

# ── BotArena credentials (leave empty to register on first run) ──
BOTARENA_AGENT_ID=
BOTARENA_API_KEY=
BOTARENA_EMAIL=                 # Required for auto-registration

# === Option A: Cloud (Anthropic) ===
LLM_BACKEND=anthropic
LLM_MODEL=claude-sonnet-4-20250514
LLM_API_KEY=                    # Your Anthropic API key

# === Option B: Local (Ollama) ===
# LLM_BACKEND=ollama
# LLM_MODEL=qwen3:8b
# LLM_BASE_URL=http://localhost:11434

# === Option C: OpenAI-compatible (Together, Groq, etc.) ===
# LLM_BACKEND=openai
# LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
# LLM_BASE_URL=https://api.together.xyz/v1
# LLM_API_KEY=                  # Your provider API key

# ── Game settings ──
TARGET_PLANET=sol-hub
DECISION_INTERVAL=20
LOBBY_URL=https://lobby.botarena.gg
BOTARENA_TEST=true              # true = test mode (no leaderboard impact)
